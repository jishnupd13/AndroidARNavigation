<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Android 12+ caps motion sensors at 200 Hz without this; ARCore's visual-inertial tracking needs the full
         IMU rate, and without it tracking can stay stuck at "starting" with IMU-timestamp errors in the log. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <!-- AR optional: the host app still installs on devices without ARCore. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <application>
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />
    </application>
</manifest>
